 fn start_pt(s: &StartPoint) -> [f64; 3] {
     match s {
         StartPoint::Known(p) => [p.x.value(), p.y.value(), p.z.value()],
         StartPoint::Unknown => [0.0, 0.0, 0.0],
     }
 }
